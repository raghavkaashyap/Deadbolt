# Supabase — get these from https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for the authenticated Deadbolt API; server-side only (keep secret!)
# Deadbolt's API stores mandates/authorizations with this key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — intent compiler and semantic intent check
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional model override (defaults to claude-opus-5-5)
# DEADBOLT_MODEL=claude-opus-5-5

# Signs authorization capabilities. Use a long random string, e.g. `openssl rand -hex 32`.
DEADBOLT_CAPABILITY_SECRET=

# PayPal Sandbox — Apps & Credentials > Sandbox > REST app
# Use a BUSINESS sandbox app; buyer PERSONAL sandbox login belongs only in PayPal.
# No live credentials, webhook ID or buyer password are needed by this server.
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Used for PayPal return URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Separate server-to-server sandbox credentials (at least 32 characters each).
# Operator: mandates, approvals, authorization/audit reads. Never share with agents.
DEADBOLT_OPERATOR_API_KEY=
# Agent: authorization and sandbox payment calls. Single trusted demo agent only.
DEADBOLT_AGENT_API_KEY=

# The single agent identity bound to DEADBOLT_AGENT_API_KEY
DEADBOLT_AGENT_ID=shopping_agent

# Optional CLI smoke-test target (defaults to NEXT_PUBLIC_APP_URL, then localhost:3000)
# DEADBOLT_BASE_URL=http://localhost:3000
